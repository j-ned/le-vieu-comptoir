---
// Navbar component
---

<header
  class="fixed w-full z-50 transition-all duration-300 bg-brand-dark-wood/95 backdrop-blur-sm shadow-md border-b border-brand-gold/20"
  id="navbar"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="shrink-0 flex items-center">
        <a
          href="#"
          class="font-serif text-2xl font-bold text-brand-gold tracking-wider"
        >
          Le Vieux Comptoir
        </a>
      </div>

      {/* Desktop Menu */}
      <nav class="hidden md:flex space-x-8 items-center">
        <a
          href="#about"
          class="text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
          >L'Établissement</a
        >
        <a
          href="#menu"
          class="text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
          >La Carte</a
        >
        <a
          href="#cigar-lounge"
          class="text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
          >Le Fumoir</a
        >
        <a
          href="#contact"
          class="text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
          >Contact</a
        >
        <a
          href="#reservation"
          class="bg-brand-bordeaux hover:bg-brand-bordeaux-light text-brand-cream px-6 py-2 rounded-sm transition-colors text-sm uppercase tracking-widest font-bold border border-brand-bordeaux-light"
        >
          Réserver
        </a>
      </nav>

      {/* Mobile menu button */}
      <div class="md:hidden flex items-center">
        <button
          type="button"
          id="mobile-menu-button"
          aria-label="Ouvrir le menu principal"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="text-brand-gold hover:text-brand-cream focus:outline-none focus:ring-2 focus:ring-brand-gold rounded-sm p-1"
        >
          <svg
            id="mobile-menu-icon-open"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="mobile-menu-icon-close"
            class="hidden h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    {/* Mobile Menu Panel */}
    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-6 space-y-1 border-t border-brand-gold/20"
    >
      <a
        href="#about"
        class="block px-2 py-3 text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
        >L'Établissement</a
      >
      <a
        href="#menu"
        class="block px-2 py-3 text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
        >La Carte</a
      >
      <a
        href="#cigar-lounge"
        class="block px-2 py-3 text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
        >Le Fumoir</a
      >
      <a
        href="#contact"
        class="block px-2 py-3 text-brand-cream hover:text-brand-gold transition-colors text-sm uppercase tracking-widest font-medium"
        >Contact</a
      >
      <a
        href="#reservation"
        class="block mt-2 bg-brand-bordeaux hover:bg-brand-bordeaux-light text-brand-cream px-6 py-3 rounded-sm transition-colors text-sm uppercase tracking-widest font-bold border border-brand-bordeaux-light text-center"
        >Réserver</a
      >
    </nav>
  </div>
</header>

<script>
  // Simple scroll effect for navbar
  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) {
      navbar?.classList.add('shadow-lg');
    } else {
      navbar?.classList.remove('shadow-lg');
    }
  });

  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute(
      'aria-label',
      open ? 'Fermer le menu principal' : 'Ouvrir le menu principal',
    );
  };

  menuButton?.addEventListener('click', () => {
    setMenu(mobileMenu?.classList.contains('hidden') ?? true);
  });

  // Close the menu when a link is tapped
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
